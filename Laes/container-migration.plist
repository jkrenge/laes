<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS reads this once, when the sandboxed app first starts, and moves what builds before the sandbox saved
     (the offline copy, unsent edits, settings) into the app's container. -->
<plist version="1.0">
<dict>
	<key>Move</key>
	<array>
		<string>${ApplicationSupport}/app.laes.Laes</string>
		<string>${Library}/Preferences/app.laes.Laes.plist</string>
	</array>
</dict>
</plist>
